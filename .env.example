NODE_ENV=development
APP_NAME=shop
APP_PREFIX=api
GATEWAY_PORT=3118
AUTH_PORT=3101
SERVICE_ADVERTISE_HOST=host.docker.internal
SERVICE_HOST_OVERRIDE=localhost

CONSUL_URL=http://localhost:8501

DIRECTUS_URL=http://localhost:8055
AUTH_JWT_SECRET=local-only-change-this-secret-before-deploy-32chars
DIRECTUS_KEY=local-development-key
DIRECTUS_SECRET=local-development-secret
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=local-dev-only
DIRECTUS_DB_NAME=directus
DIRECTUS_DB_USER=directus
DIRECTUS_DB_PASSWORD=local-dev-only

MONGODB_URL=mongodb://localhost:27017/fpt_boiplate?replicaSet=rs0

USER_PORT=3121

# Optional: seed one development user when the Auth service starts and User is empty.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_DISPLAY_NAME=

PRODUCT_PORT=3122

CART_PORT=3123
