{
  "name": "microservice-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "service": "node tools/service-cli.mjs",
    "start:local": "pnpm exec nx run-many --target=serve --projects=gateway,auth,user,product,cart --parallel=5",
    "build": "pnpm exec nx run-many --target=build --projects=gateway,auth,directus-client,user,product,cart --parallel=6",
    "typecheck": "tsc --noEmit -p apps/gateway/tsconfig.app.json && tsc --noEmit -p apps/services/auth/tsconfig.app.json && tsc --noEmit -p apps/directus/tsconfig.lib.json && pnpm exec tsc --noEmit -p apps/services/user/tsconfig.app.json && pnpm exec tsc --noEmit -p apps/services/product/tsconfig.app.json && pnpm exec tsc --noEmit -p apps/services/cart/tsconfig.app.json",
    "prisma:generate": "prisma generate --schema db/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema db/prisma/schema.prisma",
    "prisma:seed": "node --env-file=.env.local db/prisma/seed.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nx/jest": "19.8.9",
    "@nx/js": "19.8.9",
    "@nx/node": "19.8.9",
    "@nx/webpack": "19.8.9",
    "@nx/workspace": "19.8.9",
    "@types/express": "^5.0.0",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "jest": "29.7.0",
    "nx": "19.8.9",
    "prisma": "^6.7.0",
    "ts-jest": "29.2.5",
    "tslib": "^2.3.0",
    "typescript": "~5.5.4"
  }
}
